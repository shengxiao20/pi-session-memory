{
  "name": "pi-session-memory",
  "version": "0.7.1",
  "description": "Local-first cross-session & cross-agent dialogue search based on sqlite with optional local Jev semantic relevance filtering, or direct session migration from Claude Code and Codex to Pi, lightweighted as a motto, compatible in Chinese and English",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shengxiao20/pi-session-memory.git"
  },
  "homepage": "https://github.com/shengxiao20/pi-session-memory#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shengxiao20/pi-session-memory/issues"
  },
  "type": "module",
  "files": [
    "extensions/",
    "src/"
  ],
  "scripts": {
    "test": "tsx tests/core.test.ts && tsx tests/jev-filter.test.ts",
    "test:e2e": "tsx tests/e2e.test.ts",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
